# ==============================================================================
# Finevers Terminal - Environment Configuration Template
# Copy this file to .env for local deployment. Never commit actual secret keys.
# ==============================================================================

# Application Environment: 'development' or 'production'
# In 'production', wildcard CORS is rejected and strict security limits are enforced.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Backend & API Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed HTTP and WebSocket origins for CORS security.
# In production, must explicitly match the frontend URL (e.g., https://terminal.yourdomain.com).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum concurrent WebSocket client connections permitted on this node.
MAX_CLIENTS=250

# Maximum symbol subscriptions allowed per WebSocket connection.
MAX_SUBSCRIPTIONS=25

# Rate limit for heavy analytical endpoints (e.g., HAR-RV and VolTarget), in requests per minute.
ANALYTICS_RATE_LIMIT_PER_MIN=10

# ------------------------------------------------------------------------------
# Message Broker & Storage
# ------------------------------------------------------------------------------
# Redis connection URL for high-throughput pub/sub and fan-out between ingestion & WS workers.
# If unavailable or commented out, the terminal gracefully runs an in-memory pub/sub broker.
REDIS_URL=redis://localhost:6379/0

# TimescaleDB / PostgreSQL connection string for tick persistence & continuous aggregates.
# If unreachable, backend safely falls back to local SQLite dev storage.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_data

# Raw tick hypertable data retention policy in days (default: 7 days).
RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Frontend Public Endpoints (Accessible by Client Browser)
# ------------------------------------------------------------------------------
# REST API base URL for historical candles, metrics, and quantitative analytics.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket stream URL for real-time trade tape and L2 order book depth.
# If left blank, client automatically negotiates ws:// or wss:// from window.location.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ------------------------------------------------------------------------------
# Optional Broker Credentials (NSE India Adapter Stub)
# ------------------------------------------------------------------------------
# When unset, NSE symbols safely remain in labeled "NO DATA (OFFLINE)" state.
# Never hardcode live production credentials here.
NSE_BROKER_API_KEY=
NSE_BROKER_API_SECRET=
NSE_BROKER_ACCESS_TOKEN=
NSE_IS_DELAYED=true
