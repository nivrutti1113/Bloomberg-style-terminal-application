# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_CLIENTS=250
MAX_SUBSCRIPTIONS=25
ANALYTICS_RATE_LIMIT_PER_MIN=10

# Storage & Messaging
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_data
SQLITE_DB_PATH=ticks.db
RETENTION_DAYS=7

# Broker API (NSE Stub)
NSE_BROKER_API_KEY=
NSE_BROKER_API_SECRET=
NSE_BROKER_ACCESS_TOKEN=
NSE_IS_DELAYED=true
